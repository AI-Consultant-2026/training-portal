NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://training_portal:change_me@postgres:5432/training_portal_dev
TEST_DATABASE_URL=postgres://training_portal:change_me@postgres:5432/training_portal_test

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=10

STORAGE_DRIVER=local
UPLOAD_ROOT=/app/uploads

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@trainingportal.local
LEADS_NOTIFY_EMAIL=hello@paleontraining.com

# Placeholder bank-transfer details shown on the Naira payment page. Replace once Paleon
# Training Limited's receiving bank account is confirmed. (Card payments need no env vars:
# they use the Paystack links in src/constants/paystackPaymentLinks.ts.)
# Bank transfer payments are ON unless this is exactly "false". While off, the bank-transfer
# page shows a "temporarily unavailable" notice and POST /api/payments/bank-transfer returns 503.
BANK_TRANSFER_ENABLED=true
# Amber "Temporary payment arrangement" notice on the bank-transfer page (interim
# account). Set to false once the BANK_TRANSFER_* details are the permanent business account.
BANK_TRANSFER_TEMPORARY_NOTICE=true
BANK_TRANSFER_BANK_NAME=PLACEHOLDER BANK NAME
BANK_TRANSFER_ACCOUNT_NAME=Paleon Training Limited
BANK_TRANSFER_ACCOUNT_NUMBER=0000000000
# Not shown on the Naira payment page (sort codes are not used for Nigerian transfers).
BANK_TRANSFER_SORT_CODE_OR_IBAN=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to keep analytics off.
GA4_MEASUREMENT_ID=

# Meta Pixel ID (digits only, from Meta Events Manager) for measuring Facebook/Instagram ads.
# Leave empty to keep the Pixel off. It only loads after a visitor accepts cookies.
META_PIXEL_ID=
