NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://training_portal:change_me@postgres:5432/training_portal_dev
TEST_DATABASE_URL=postgres://training_portal:change_me@postgres:5432/training_portal_test

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=10

STORAGE_DRIVER=local
UPLOAD_ROOT=/app/uploads

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@trainingportal.local
LEADS_NOTIFY_EMAIL=hello@paleontraining.com

# Placeholder bank-transfer details shown on the Naira payment page, and a placeholder
# card-gateway API key (unused by the current mock gateway). Replace once Paleon
# Training UK Limited's real merchant account and receiving bank account are confirmed.
BANK_TRANSFER_BANK_NAME=PLACEHOLDER BANK NAME
BANK_TRANSFER_ACCOUNT_NAME=Paleon Training UK Limited
BANK_TRANSFER_ACCOUNT_NUMBER=0000000000
BANK_TRANSFER_SORT_CODE_OR_IBAN=00-00-00
PAYMENT_GATEWAY_API_KEY=
